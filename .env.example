# Vestige Cloudflare Worker environment reference.
# Do not place real secrets in this file or commit them to GitHub.
# Production secrets belong in Cloudflare Worker secrets / environment variables.

# Core Zoho Books OAuth / organisation
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ADMIN_TEST_KEY=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Checkout / owner security
CHECKOUT_SIGNING_SECRET=
VESTIGE_PAYMENT_ADMIN_KEY=
VESTIGE_COLLECTION_ACCESS_CODE=
ALLOWED_ORIGIN=https://vestigeltd.co.za
OWNER_CONSOLE_URL=https://vestigeltd.co.za/owner

# Owner notifications
RESEND_API_KEY=

# Zoho banking / EFT integration where configured
ZOHO_BANK_ACCOUNT_ID=
EFT_BANK_NAME=
EFT_ACCOUNT_HOLDER=
EFT_ACCOUNT_NUMBER=
EFT_ACCOUNT_TYPE=
EFT_BRANCH_CODE=
EFT_SWIFT_CODE=

# Permanent BC10000 Zoho item pins
ZOHO_ITEM_BLUEBERRY_MINT_ID=
ZOHO_ITEM_MIAMI_MINT_ID=
ZOHO_ITEM_BLUE_RAZZ_ICE_ID=
ZOHO_ITEM_STRAWBERRY_KIWI_ICE_ID=
ZOHO_ITEM_WATERMELON_ICE_ID=

# Optional fulfilment-location pin
ZOHO_LOCATION_ID=

# CHECKOUT_DB and ASSETS are Cloudflare bindings declared in wrangler.toml,
# not string environment variables.
