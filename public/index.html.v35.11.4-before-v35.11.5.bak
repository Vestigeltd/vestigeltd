<div class="container">
<div class="section-heading shop-heading">
<p class="eyebrow gold-text">SHOP</p>
<h2>Select your BC10000</h2>
<p>Enter your billing/contact details, select your Courier Guy locker, choose an in-stock flavour and quantity, then review the total. Stock, customer records, invoicing and payment confirmation are validated through Zoho Books.</p>
</div>
<div class="checkout-shell">
<form class="order-form" id="orderForm" novalidate="">
<section aria-labelledby="productSelectionHeading" class="checkout-block product-selection-block">
<div class="checkout-block-head"><span>01</span><h3 id="productSelectionHeading">Product Selection</h3></div>
<div class="product-select-grid">
<label>Choose your flavour
              <select id="flavourSelect" name="flavour" required="">
<option value="">Select a flavour</option>
<option value="Blueberry Mint">Blueberry Mint</option>
<option value="Miami Mint">Miami Mint</option>
<option value="Blue Razz Ice">Blue Razz Ice</option>
<option value="Strawberry Kiwi Ice">Strawberry Kiwi Ice</option>
<option value="Watermelon Ice">Watermelon Ice</option>
</select>
</label>
<label>Quantity
              <select id="quantity" name="quantity" required="">
<option value="" selected></option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option>
</select>
</label>
</div>
<div class="stock-feedback">
<small class="stock-status" id="stockStatus">Checking product availability in Zoho Books…</small>
<button class="stock-retry" hidden="" id="retryStock" type="button">Retry stock check</button>
</div>
</section>
<section aria-labelledby="customerHeading" class="checkout-block">
<div class="checkout-block-head"><span>02</span><h3 id="customerHeading">Customer</h3></div>
<div class="form-grid customer-grid">
<label>Full name<input autocomplete="name" maxlength="100" name="name" required="" type="text"/></label>
<label>Mobile<input autocomplete="tel" inputmode="tel" maxlength="50" name="mobile" placeholder="e.g. +27 82 123 4567" required="" type="tel"/></label>
<label class="full">E-mail<input autocomplete="email" maxlength="100" name="email" required="" type="email"/></label>
</div>
</section>
<section aria-labelledby="billingHeading" class="checkout-block">
<div class="checkout-block-head"><span>03</span><h3 id="billingHeading">Billing Address</h3></div>
<input name="country" type="hidden" value="South Africa"/>
<div class="form-grid billing-grid">
<label class="full">Road / Street<input autocomplete="address-line1" maxlength="500" name="addressLine1" required="" type="text"/></label>
<label class="full">Suburb<input autocomplete="address-line2" maxlength="255" name="addressLine2" required="" type="text"/></label>
<label>City<input autocomplete="address-level2" maxlength="100" name="city" required="" type="text"/></label>
<label>Province<input autocomplete="address-level1" maxlength="100" name="province" required="" type="text"/></label>
<label>Postcode<input autocomplete="postal-code" inputmode="numeric" maxlength="50" name="postalCode" required="" type="text"/></label>
</div>
</section>
<section aria-labelledby="deliveryHeading" class="checkout-block delivery-details-block">
<div class="checkout-block-head"><span>04</span><h3 id="deliveryHeading">Delivery or Collection</h3></div>
<fieldset class="fulfilment-options">
<legend>How would you like to receive your order?</legend>
<label class="fulfilment-option"><input checked="" name="deliveryMethod" type="radio" value="courier_locker"/><span><strong>The Courier Guy — Locker to Locker</strong><small>R60.00 delivery</small></span></label>
<label class="fulfilment-option fulfilment-option-locked" id="collectionOption"><input disabled="" id="collectionMethod" name="deliveryMethod" type="radio" value="collection"/><span><strong>Collect from Vestige Ltd <em id="collectionLockLabel">— access code required</em></strong><small>R0.00 — available only after collection access is validated</small></span></label>
</fieldset>
<div class="collection-access-panel" id="collectionAccessPanel">
<label>Collection access code
<input autocomplete="off" id="collectionAccessCode" maxlength="128" spellcheck="false" type="password" placeholder="Enter collection access code"/>
</label>
<button class="btn btn-outline" id="validateCollectionAccess" type="button">Validate collection code</button>
<p class="collection-access-status" id="collectionAccessStatus" role="status">Collection remains locked until the code is validated.</p>
</div>
<div class="form-grid" id="courierLockerWrap">
<label class="full">Courier Locker<input aria-describedby="courierLockerHelp courierProviderHelp" autocomplete="off" maxlength="120" minlength="2" name="courierLocker" pattern="[A-Za-z0-9 ]+" placeholder="Enter Courier Locker name or code" required="" type="text"/><small class="field-help" id="courierLockerHelp">Mandatory for Locker-to-Locker delivery. Letters, numbers and spaces only.</small><small class="courier-provider-help" id="courierProviderHelp">Not familiar with the delivery provider? <a href="https://thecourierguy.co.za/" rel="noopener noreferrer" target="_blank">Visit The Courier Guy ↗</a></small></label>
</div>
<p class="collection-note" id="collectionNote" hidden>Collection has no delivery charge. Collection arrangements are handled directly with Vestige Ltd; no business address is published on the checkout page.</p>
</section>
<div aria-live="polite" class="confirmation-wrap">
