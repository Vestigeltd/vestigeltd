*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#eef2f7;background:#06101d;line-height:1.6}img{max-width:100%;height:auto;display:block}a{color:inherit;text-decoration:none}button,a{-webkit-tap-highlight-color:transparent}.container{width:92%;max-width:1220px;margin:0 auto}.narrow{max-width:850px}.gold-text{color:#c89b43}.eyebrow{margin:0 0 12px;font-size:11px;font-weight:bold;letter-spacing:4px;text-transform:uppercase}.site-header{position:sticky;top:0;z-index:50;background:rgba(6,16,29,.96);border-bottom:1px solid rgba(200,155,67,.2);backdrop-filter:blur(10px)}.nav-wrap{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{display:flex;align-items:center;gap:13px;min-width:220px}.brand-logo{width:52px;height:52px;object-fit:contain}.brand-name{font-family:Georgia,'Times New Roman',serif;letter-spacing:3px;font-size:16px}.brand-name b{color:#c89b43;font-weight:normal}.main-nav{display:flex;align-items:center;gap:25px;font-size:12px;letter-spacing:1px}.main-nav a:hover{color:#d4aa58}.nav-toggle{display:none;background:none;border:1px solid rgba(200,155,67,.45);color:#fff;padding:9px 13px}.hero{min-height:720px;position:relative;display:flex;align-items:center;overflow:hidden;background:#071525 url('assets/bc10000-showcase.png') center/cover no-repeat}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,10,20,.96),rgba(4,16,29,.8) 48%,rgba(4,16,29,.28))}.hero-content{position:relative;z-index:2}.hero-copy{width:58%;padding:80px 0}.hero h1,h1,h2,h3{font-family:Georgia,'Times New Roman',serif;font-weight:400;line-height:1.1}.hero h1{font-size:clamp(50px,8vw,105px);margin:0 0 18px;letter-spacing:-2px}.hero h1 span{display:block;color:#c89b43}.hero-lede{font-family:Georgia,serif;font-size:23px;max-width:640px;color:#f7f1e4}.hero-text{max-width:620px;color:#bdc7d2}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.btn{display:inline-block;padding:13px 22px;border:1px solid #c89b43;font-weight:bold;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer}.btn-gold{background:#c89b43;color:#07101b}.btn-light{color:#fff;border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.06)}.btn-outline{color:#fff;background:transparent;border:1px solid rgba(255,255,255,.33)}.intro{padding:100px 0 70px;background:#0a1524}.intro-grid{display:flex;gap:70px;align-items:center}.intro-grid>div{flex:1}.intro p{color:#aeb9c7}.metric-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(200,155,67,.16)}.metric{background:#0b1727;padding:28px;min-height:130px}.metric strong{display:block;color:#d2aa5b;font-family:Georgia,serif;font-size:32px}.metric span{color:#8f9aaa;font-size:12px}.footnote{color:#657181;font-size:11px;margin-top:25px}.spec-section{padding:105px 0;background:#f4f1ea;color:#111a26}.section-heading{max-width:780px;margin-bottom:42px}.section-heading h2{font-size:clamp(38px,5vw,62px);margin:0 0 16px}.section-heading p:not(.eyebrow){color:#667181}.table-shell{width:100%;overflow-x:auto}.spec-table{width:100%;min-width:900px;border-collapse:collapse;background:#fff;border:1px solid #d6d9dd;box-shadow:0 18px 45px rgba(23,37,56,.09)}.spec-table caption{text-align:left;padding:19px 22px;background:#0b1727;color:#fff;font-family:Georgia,serif;font-size:22px;border-bottom:4px solid #c89b43}.spec-table th,.spec-table td{padding:17px 20px;border-bottom:1px solid #e4e6e9;text-align:left;vertical-align:middle}.spec-table th{width:24%;font-weight:700;color:#465261;background:#faf9f6}.spec-table td{color:#172231}.spec-table tbody tr:nth-child(even) td:not(.device-cell){background:#fbfcfd}.device-cell{width:48%;padding:0!important;background:#fff!important;border-left:1px solid #d6d9dd;border-bottom:0!important;vertical-align:top!important}.device-stage{position:relative;min-height:690px;height:100%;overflow:hidden;background:#fff;display:flex;align-items:center;justify-content:center}.device-cutout{position:relative;z-index:5;width:245px;max-width:48%;filter:drop-shadow(0 25px 25px rgba(0,0,0,.7));animation:deviceFloat 4.5s ease-in-out infinite}.device-video{position:relative;z-index:5;width:100%;height:100%;max-height:650px;object-fit:contain;display:block;background:transparent;filter:drop-shadow(0 18px 24px rgba(7,19,33,.18))}.device-halo{position:absolute;width:260px;height:340px;border-radius:50%;background:rgba(200,155,67,.09);filter:blur(35px);z-index:1}.orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(212,170,88,.55);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}.orbit-a{width:390px;height:250px;animation:orbit 10s linear infinite}.orbit-b{width:470px;height:330px;animation:orbitReverse 14s linear infinite}.orbit-c{width:320px;height:460px;animation:orbit 18s linear infinite}.callout-lines{position:absolute;inset:0;width:100%;height:100%;z-index:4;pointer-events:none}.callout-lines path{fill:none;stroke:#d4aa58;stroke-width:1.5;stroke-dasharray:5 5;opacity:.9;animation:linePulse 2s ease-in-out infinite}.feature-callout{position:absolute;z-index:8;color:#172231;font-size:11px;display:flex;align-items:center;gap:8px;text-shadow:0 1px 2px rgba(255,255,255,.8);transition:opacity .45s,transform .45s}.feature-callout b{display:block;color:#e0b965;letter-spacing:.6px}.feature-callout small{display:block;color:#667181;margin-top:2px}.dot{width:8px;height:8px;border-radius:50%;background:#d4aa58;box-shadow:0 0 0 5px rgba(212,170,88,.14),0 0 18px #d4aa58;flex:0 0 auto}.callout-left{left:5%;top:20%}.callout-right{right:4%;top:29%}.callout-bottom{left:12%;bottom:16%}.cycle-badge{position:absolute;z-index:8;right:18px;bottom:16px;color:#9b732d;font-size:10px;letter-spacing:2px;text-transform:uppercase;display:flex;gap:7px;align-items:center}.cycle-badge span{font-family:Georgia,serif;font-size:18px}.cycle-badge i{width:5px;height:5px;background:#d4aa58;border-radius:50%}.cycle-badge em{font-style:normal;color:#667181;letter-spacing:1px}.table-note{font-size:11px;color:#6b7480;margin-top:12px}.features{padding:100px 0;background:#071321}.center{margin-left:auto;margin-right:auto;text-align:center}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.feature-grid article{padding:30px;border:1px solid rgba(255,255,255,.08);background:#0b1828;min-height:240px}.feature-number{color:#c89b43;font-size:12px;letter-spacing:2px}.feature-grid h3{font-size:29px;margin:20px 0 12px}.feature-grid p{color:#9ba7b5;font-size:14px}.flavours{padding:100px 0;background:#f5f3ee;color:#101a26}.flavour-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.flavour{min-height:285px;padding:25px;position:relative;overflow:hidden;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;border:1px solid rgba(255,255,255,.18);box-shadow:0 12px 30px rgba(0,0,0,.12)}.flavour:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.82),rgba(0,0,0,.02) 70%)}.flavour>*{position:relative;z-index:2}.flavour h3{font-size:25px;margin:7px 0}.flavour p{margin:0;color:#f1f3f5;font-size:12px}.ingredient{position:absolute;top:20px;left:22px;font-size:34px;letter-spacing:4px;text-shadow:0 4px 12px #0006}.ingredient span{font-size:30px}.f-blue{background:linear-gradient(145deg,#0875d1,#0d4b73 48%,#071b2b)}.f-green{background:linear-gradient(145deg,#19ad67,#146c54 48%,#08251e)}.f-purple{background:linear-gradient(145deg,#5b4fd6,#253c8e 52%,#1a1a3b)}.f-straw{background:linear-gradient(145deg,#e84d7e,#a52f5e 45%,#274f3d)}.f-water{background:linear-gradient(145deg,#f03f31,#a82c2c 48%,#173c31)}.true-life{margin:28px 0 35px;padding:25px 28px;border-left:3px solid #c89b43;background:#fff;border-top:1px solid #e2e0db;border-right:1px solid #e2e0db;border-bottom:1px solid #e2e0db}.true-life span{font-family:Georgia,serif;letter-spacing:2px;color:#0b1727}.true-life p{margin:8px 0 0;color:#667181}.range-image{width:100%;border:1px solid #d9d8d2;box-shadow:0 18px 45px rgba(20,28,38,.12)}.faq{padding:100px 0;background:#0a1524}.faq details{border-top:1px solid rgba(200,155,67,.22);padding:22px 0}.faq details:last-child{border-bottom:1px solid rgba(200,155,67,.22)}.faq summary{cursor:pointer;color:#f2eee5;font-family:Georgia,serif;font-size:21px}.faq details p{color:#9eabb9;max-width:760px}.information{padding:100px 0;background:#f4f1ea;color:#101a26}.info-grid{display:flex;gap:70px;align-items:stretch}.info-grid>div{flex:1}.info-grid p{color:#667181}.info-card{background:#0b1727;color:#fff;padding:38px;border-top:3px solid #c89b43;display:flex;flex-direction:column;align-items:flex-start}.info-card p{margin-bottom:3px}.social{color:#d4aa58;font-family:Georgia,serif;font-size:23px;margin-bottom:25px}.social.large{font-size:30px;display:inline-block;margin-top:15px}.footer{background:#030a12;color:#8390a0;font-size:12px}.footer-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer a{color:#d4aa58}.footer-warning{text-align:center;padding:13px 20px;border-top:1px solid rgba(200,155,67,.12);color:#667181}.contact-hero{padding:120px 0;background:linear-gradient(135deg,#071321,#0c1d30);min-height:480px}.contact-hero h1{font-size:clamp(55px,8vw,100px);margin:0 0 20px}.contact-hero p:not(.eyebrow){color:#aeb9c7;max-width:700px;font-size:18px}.contact-section{padding:100px 0;background:#f4f1ea;color:#101a26}.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px}.contact-card{background:#fff;border:1px solid #dededb;padding:42px;box-shadow:0 15px 40px rgba(23,37,56,.08)}.contact-card h2{margin:15px 0;font-size:38px}.contact-card p{color:#667181}.small-note{font-size:12px}.contact-card .small-note a{color:#c89b43;text-decoration:underline;text-underline-offset:3px}.age-gate{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:100;display:flex;align-items:center;justify-content:center;padding:20px}.age-gate.hidden{display:none}.age-card{max-width:520px;background:#0b1727;border:1px solid rgba(200,155,67,.4);padding:35px;color:#fff;text-align:center;box-shadow:0 30px 70px #000}.age-logo{width:105px;height:105px;object-fit:contain;margin:0 auto 15px}.age-card h2{font-size:34px;margin:10px 0}.age-card p:not(.eyebrow){color:#aeb9c7}.age-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:25px}
@keyframes orbit{from{transform:translate(-50%,-50%) rotate(0deg)}to{transform:translate(-50%,-50%) rotate(360deg)}}@keyframes orbitReverse{from{transform:translate(-50%,-50%) rotate(360deg)}to{transform:translate(-50%,-50%) rotate(0deg)}}@keyframes deviceFloat{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-9px) rotate(1deg)}}@keyframes linePulse{0%,100%{opacity:.45}50%{opacity:1}}
@media(max-width:980px){.main-nav{gap:15px}.hero-copy{width:70%}.intro-grid,.info-grid{flex-direction:column;align-items:stretch}.feature-grid{grid-template-columns:repeat(2,1fr)}.flavour-grid{grid-template-columns:repeat(3,1fr)}.flavour:nth-child(4),.flavour:nth-child(5){min-height:250px}.device-cell{width:45%}.device-stage{min-height:610px}.device-cutout{width:205px}.device-video{max-height:570px}.callout-left{left:3%}.callout-right{right:2%}}
@media(max-width:760px){.nav-toggle{display:block}.main-nav{display:none;position:absolute;left:4%;right:4%;top:82px;background:#06101d;border:1px solid rgba(200,155,67,.2);padding:18px;flex-direction:column;align-items:flex-start}.main-nav.open{display:flex}.hero{min-height:620px}.hero-copy{width:100%;padding:60px 0}.intro{padding:75px 0 55px}.metric-grid{width:100%}.spec-section,.features,.flavours,.faq,.information,.contact-section{padding:75px 0}.section-heading{margin-bottom:32px}.spec-table{min-width:0;display:block}.spec-table caption{display:block}.spec-table tbody,.spec-table tr,.spec-table th,.spec-table td{display:block;width:100%}.spec-table th{border-bottom:0;padding-bottom:7px}.spec-table td{padding-top:7px}.spec-table .device-cell{display:block;width:100%;padding:0!important}.device-stage{min-height:590px}.device-cutout{max-width:42%;width:190px}.device-video{max-height:550px}.callout-left{left:4%;top:17%}.callout-right{right:4%;top:29%}.callout-bottom{left:7%;bottom:12%}.feature-grid,.contact-grid{grid-template-columns:1fr}.flavour-grid{grid-template-columns:1fr 1fr}.flavour{min-height:245px}.flavour:last-child{grid-column:1/-1}.footer-inner{flex-direction:column;justify-content:center;padding:18px 0}.brand-name{font-size:13px;letter-spacing:2px}.brand-logo{width:46px;height:46px}}
@media(max-width:480px){.container{width:94%}.hero h1{font-size:48px}.hero-lede{font-size:19px}.metric-grid{grid-template-columns:1fr}.flavour-grid{grid-template-columns:1fr}.flavour,.flavour:last-child{grid-column:auto}.device-stage{min-height:560px}.device-cutout{max-width:44%;width:175px}.device-video{max-height:520px}.callout-left{top:14%}.callout-right{top:27%}.callout-bottom{bottom:10%}.callout-lines{opacity:.8}.age-card{padding:26px}.age-logo{width:85px;height:85px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.orbit,.device-cutout,.callout-lines path{animation:none}.device-video{animation:none}}


/* Mobile technical profile table redesign */
@media screen and (max-width:768px){
 .spec-table{display:table!important;min-width:100%;table-layout:fixed;border-collapse:collapse}
 .spec-table caption{display:table-caption}
 .spec-table tbody{display:table-row-group}
 .spec-table tr{display:table-row}
 .spec-table th,.spec-table td{display:table-cell!important;width:auto;padding:10px 12px;font-size:14px;line-height:1.25;vertical-align:middle}
 .spec-table th{width:42%}
 .spec-table td:not(.video-column){width:58%}
 .spec-table .video-column{display:none!important}
 .spec-table .mobile-video-row{display:table-row!important}
 .spec-table .mobile-video-row td{display:table-cell!important;padding:0;border:none}
 .mobile-video-wrapper{width:100%;background:#000;overflow:visible;border-radius:0 0 14px 14px;display:flex;justify-content:center;align-items:center;padding:0}
 .mobile-video-wrapper video{display:block;width:100%;height:auto;max-height:none;aspect-ratio:9/16;object-fit:contain;background:#000}
 .device-stage{min-height:auto;height:auto}
}
@media screen and (min-width:769px){.mobile-video-row{display:none}}

/* Shop customer record fields */
.field-optional{font-size:.78em;opacity:.72;font-weight:400}
.address-note{margin:1rem 0 1.25rem;padding:.9rem 1rem;border:1px solid rgba(201,162,74,.28);border-radius:10px;background:rgba(201,162,74,.06);font-size:.92rem;line-height:1.5}

/* V8 delivery + checkout presentation */
.delivery{padding:88px 0 72px;background:#071321;border-top:1px solid rgba(200,155,67,.14)}
.delivery-layout{display:flex;justify-content:center}
.delivery-copy{width:min(100%,880px);text-align:left}
.delivery-copy h2{font-size:clamp(38px,5vw,58px);margin:0 0 24px;color:#f7f1e4}
.delivery-line{margin:0 0 8px;color:#b4c0cd;font-size:16px}
.delivery-link{display:inline-block;margin-top:24px;color:#d4aa58;font-weight:700;letter-spacing:.5px;border-bottom:1px solid rgba(212,170,88,.45);padding-bottom:3px}
.delivery-link:hover{color:#f0c977;border-color:#f0c977}
.delivery-price{margin-top:24px;color:#d4aa58;font-family:Georgia,'Times New Roman',serif;font-size:38px;line-height:1;font-weight:400}
.buy-now{padding:92px 0 110px;background:#f4f1ea;color:#111a26}
.shop-heading{margin-bottom:34px}
.checkout-shell{max-width:940px;margin:0 auto}
.order-form{background:#fff;border:1px solid #d9dde2;box-shadow:0 20px 54px rgba(23,37,56,.09);padding:0;overflow:hidden}
.checkout-block{padding:28px 34px 30px;border-bottom:1px solid #e7e9ec}
.checkout-block-head{display:flex;align-items:center;gap:13px;margin-bottom:21px}
.checkout-block-head>span{display:grid;place-items:center;width:31px;height:31px;border-radius:50%;background:#0b1727;color:#d4aa58;font-size:11px;font-weight:700;letter-spacing:1px;flex:0 0 auto}
.checkout-block-head h3{margin:0;color:#0b1727;font-size:25px;letter-spacing:.1px}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 20px}
.form-grid .full{grid-column:1/-1}
.order-form label{display:flex;flex-direction:column;gap:7px;color:#344252;font-size:12px;font-weight:700;letter-spacing:.35px}
.order-form input,.order-form select{width:100%;min-height:46px;border:1px solid #ccd3da;border-radius:4px;background:#fff;color:#12202f;padding:10px 12px;font:inherit;font-size:15px;line-height:1.25;outline:none;transition:border-color .18s,box-shadow .18s,background .18s}
.order-form input:focus,.order-form select:focus{border-color:#b68a36;box-shadow:0 0 0 3px rgba(200,155,67,.14)}
.order-form input:disabled,.order-form select:disabled{background:#f4f5f6;color:#7a8590;cursor:not-allowed}
.field-help{font-weight:400;color:#778391;font-size:11px;letter-spacing:0;line-height:1.4}
.product-select-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(120px,.7fr);gap:20px;align-items:end}
.stock-feedback{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px;min-height:25px}
.stock-status{display:block;color:#6d7884;font-size:12px;font-weight:400;letter-spacing:0}
.stock-status.ok{color:#2e6f50}.stock-status.warn{color:#9a5a2a}
.stock-retry{border:0;background:transparent;color:#9b732d;text-decoration:underline;text-underline-offset:3px;font-weight:700;cursor:pointer;padding:4px 0;white-space:nowrap}
.confirmation-wrap{padding:26px 34px 8px;background:#fbfaf7}
.confirmation-table{width:100%;border-collapse:collapse;border:1px solid #d9dde2;background:#fff;font-size:14px}
.confirmation-table th,.confirmation-table td{padding:11px 14px;border-bottom:1px solid #e4e7ea;text-align:left}
.confirmation-table th{width:68%;font-weight:600;color:#465261;background:#faf9f6}
.confirmation-table td{text-align:right;font-weight:700;color:#172231;font-variant-numeric:tabular-nums}
.confirmation-table .confirmation-total th,.confirmation-table .confirmation-total td{background:#0b1727;color:#fff;border-bottom:0;font-size:15px}
.checkout-submit{margin:24px 34px 6px;width:calc(100% - 68px);text-align:center;border-radius:2px}
.checkout-submit:disabled{opacity:.45;cursor:not-allowed}
.order-status{margin:12px 34px 24px;color:#526170;font-size:13px;min-height:20px}
.payment-panel{margin:20px 34px 30px;padding:22px 24px;border:1px solid rgba(200,155,67,.35);background:#0b1727;color:#fff}
.payment-panel h3{margin:0 0 10px;font-size:23px;color:#f7f1e4}
.payment-panel p{margin:0 0 18px;color:#b7c1cc;font-size:13px}
.payment-panel .btn{margin-right:8px;margin-bottom:8px}
.receipt-panel{border-color:rgba(74,145,107,.45)}
.contact-card .contact-detail{color:#667181;font-size:inherit;line-height:1.6;margin:.35em 0}
.contact-card .contact-detail a{color:#c89b43;text-decoration:underline;text-underline-offset:3px}

@media(max-width:760px){
 .delivery{padding:66px 0 58px}.delivery-copy h2{font-size:38px}.delivery-line{font-size:15px}.delivery-price{font-size:34px}
 .buy-now{padding:68px 0 80px}.checkout-shell{width:100%}.order-form{border-radius:0}.checkout-block{padding:24px 20px 25px}.checkout-block-head{margin-bottom:18px}.checkout-block-head h3{font-size:23px}
 .form-grid,.product-select-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}.stock-feedback{align-items:flex-start;flex-direction:column;gap:6px}
 .confirmation-wrap{padding:22px 20px 7px}.confirmation-table th{width:62%}.confirmation-table th,.confirmation-table td{padding:10px 11px}
 .checkout-submit{margin:22px 20px 6px;width:calc(100% - 40px)}.order-status{margin:12px 20px 22px}.payment-panel{margin:18px 20px 24px;padding:20px}
}
@media(max-width:480px){
 .delivery-copy h2{font-size:34px}.checkout-block{padding-left:16px;padding-right:16px}.checkout-block-head>span{width:29px;height:29px}.checkout-block-head h3{font-size:21px}
 .confirmation-wrap{padding-left:16px;padding-right:16px}.confirmation-table{font-size:13px}.confirmation-table th{width:58%}.checkout-submit{margin-left:16px;margin-right:16px;width:calc(100% - 32px)}.order-status{margin-left:16px;margin-right:16px}.payment-panel{margin-left:16px;margin-right:16px}
}


/* v32.7 — checkout basket controls on the light order form */
#vestigeCartBuilder{background:#fbfaf7!important;border:1px solid #d8c28d!important;color:#172231!important;position:relative;z-index:2}
#vestigeCartBuilder .cart-hint{color:#526170!important}
#addToBasket{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:46px!important;background:#0b1727!important;color:#fff!important;border:1px solid #0b1727!important;opacity:1!important;visibility:visible!important;pointer-events:auto!important;cursor:pointer!important;position:relative!important;z-index:3!important}
#addToBasket:hover,#addToBasket:focus{background:#15283e!important;border-color:#c89b43!important;color:#fff!important}
#orderSubmit{pointer-events:auto!important;cursor:pointer!important;opacity:1!important;position:relative!important;z-index:2!important}
#orderStatus{color:#344252!important;font-weight:600!important;min-height:24px!important}
#vestigeCart{color:#172231!important}
#vestigeCart .cart-head,#vestigeCart .cart-foot,#vestigeCart .cart-row{color:#344252!important;border-color:#e0e3e6!important}
#vestigeCart .cart-row strong,#vestigeCart .cart-foot strong,#vestigeCart .cart-head strong{color:#172231!important}
#vestigeCart .cart-row small,#vestigeCart .cart-row>span{color:#526170!important}
#vestigeCart .cart-remove{color:#9b732d!important}

/* V34.8.1 — understated service-provider helper link */
.courier-provider-help{
 display:block;
 margin-top:2px;
 color:#778391;
 font-size:11px;
 font-weight:400;
 letter-spacing:0;
 line-height:1.4;
}
.courier-provider-help a{
 color:#9b732d;
 font-weight:700;
 text-decoration:underline;
 text-decoration-thickness:1px;
 text-underline-offset:3px;
}
.courier-provider-help a:hover,
.courier-provider-help a:focus-visible{
 color:#76551e;
 outline:none;
}

/* V34.9 — customer cancellation after bank-payment checkout begins */
.bank-status-actions{
 display:flex;
 flex-wrap:wrap;
 gap:10px;
 align-items:center;
}
.bank-status-actions .btn{margin:0}
.bank-cancel-order{
 background:transparent;
 color:#b34a42;
 border:1px solid rgba(179,74,66,.45);
}
.bank-cancel-order:hover,
.bank-cancel-order:focus-visible{
 color:#8f302a;
 border-color:#8f302a;
 background:rgba(179,74,66,.05);
 outline:none;
}
@media(max-width:640px){
 .bank-status-actions .btn{
  width:100%;
  text-align:center;
 }
}

/* V35 — discreet owner console navigation entry */
.main-nav .nav-owner{
 color:#6d7884;
 font-size:11px;
 letter-spacing:.9px;
 text-transform:uppercase;
}
.main-nav .nav-owner:hover,
.main-nav .nav-owner:focus-visible{
 color:#b68a36;
}

/* V35.2 — resilient pending bank-checkout recovery */
.bank-recovery-note{
 display:block;
 margin-top:5px;
 color:#75808b;
 font-size:11px;
 font-weight:400;
 line-height:1.45;
}
#customerReservationCountdown{
 display:inline-block;
 margin-left:3px;
 color:#74541f;
}
#customerReservationCountdown.reservation-ending{
 color:#a5433d;
}
#customerReservationCountdown.reservation-expired{
 color:#a5433d;
 text-decoration:underline;
 text-underline-offset:2px;
}


/* V35.6 — delivery/collection selector */
.fulfilment-options{border:0;padding:0;margin:0 0 16px;display:grid;gap:9px}
.fulfilment-options legend{font-size:12px;font-weight:700;margin-bottom:8px;color:#344252}
.fulfilment-option{display:flex!important;flex-direction:row!important;align-items:center!important;gap:11px!important;border:1px solid #d8dde2;border-radius:6px;padding:13px 14px;background:#fff;cursor:pointer}
.fulfilment-option:has(input:checked){border-color:#b68a36;background:#fffdf8}
.fulfilment-option input{width:17px;height:17px;min-height:0;margin:0;accent-color:#9b732d}
.fulfilment-option span{display:flex;flex-direction:column;gap:3px}
.fulfilment-option strong{font-size:13px;color:#172231}
.fulfilment-option small{font-size:11px;color:#6d7884;font-weight:400}
.collection-note{margin:5px 0 0;padding:10px 12px;border-left:3px solid #b68a36;background:#fffdf8;color:#687482;font-size:11px;line-height:1.5}


/* V35.6.1 — protected collection access */
.fulfilment-option-locked{opacity:.62}
.fulfilment-option-locked strong em{font-style:normal;color:#8b6724;font-size:10px;font-weight:700}
.collection-access-panel{margin:0 0 16px;padding:13px 14px;border:1px solid #e0e4e7;border-radius:6px;background:#faf9f6;display:grid;grid-template-columns:minmax(200px,1fr) auto;gap:10px;align-items:end}
.collection-access-panel label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:700;color:#344252}
.collection-access-panel input{min-height:42px;border:1px solid #ccd3da;border-radius:5px;padding:9px 11px;font-size:14px;background:#fff}
.collection-access-status{grid-column:1/-1;margin:0;color:#6d7884;font-size:10px;line-height:1.4}
.collection-access-status.ok{color:#2e6f50;font-weight:700}
.collection-access-status.error{color:#a5433d;font-weight:700}
@media(max-width:640px){.collection-access-panel{grid-template-columns:1fr}.collection-access-panel .btn{width:100%}}


/* V35.7 — checkout help/accessibility polish */
.checkout-help-link{margin:7px 0 0;color:#6d7884;font-size:11px;line-height:1.5}
.checkout-help-link a{color:#8b6724;font-weight:700;text-decoration:underline;text-underline-offset:3px}
.btn:focus-visible,button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{
 outline:2px solid #b68a36;outline-offset:2px
}
@media(max-width:640px){
 .checkout-help-link{font-size:12px}
 .fulfilment-option{padding:12px}
 .collection-access-panel{padding:12px}
}


/* V35.8.4 — Contact hero Italianno trial */
.contact-hero{
  padding:120px 0;
  background:linear-gradient(135deg,#071321 0%,#0b2440 52%,#0d3156 100%);
  min-height:480px;
  overflow:hidden;
}
.contact-hero-grid{
  min-height:300px;
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);
  gap:54px;
  align-items:center;
}
.contact-hero-copy{padding-top:6px}
.contact-hero h1{
  font-size:clamp(55px,8vw,100px);
  margin:0 0 34px;
}
.contact-hero .contact-hero-message{
  margin:0;
  max-width:760px;
  color:#f3eee5;
  font-family:'Italianno','Brush Script MT','Segoe Script',cursive;
  font-size:clamp(34px,4.2vw,55px);
  line-height:1.12;
  letter-spacing:.15px;
}
.contact-hero .contact-hero-message span{color:#d4aa58}
.contact-hero-mark{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:270px;
}
.contact-hero-mark img{
  width:min(100%,300px);
  height:auto;
  opacity:.94;
  mix-blend-mode:multiply;
  filter:contrast(1.05) saturate(.95);
}
@media(max-width:760px){
  .contact-hero{padding:92px 0 76px;min-height:auto}
  .contact-hero-grid{grid-template-columns:1fr;gap:30px;text-align:center}
  .contact-hero h1{margin-bottom:28px}
  .contact-hero .contact-hero-message{margin-inline:auto;font-size:clamp(32px,9vw,44px)}
  .contact-hero-mark{min-height:auto}
  .contact-hero-mark img{width:min(62vw,210px)}
}


/* V35.8.5 — contact hero original typography/layout refinement */
.contact-hero{
  padding:120px 0;
  background:linear-gradient(135deg,#071321 0%,#0b2440 52%,#0d3156 100%);
  min-height:480px;
  overflow:hidden;
}
.contact-hero-refined{
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:42px;
}
.contact-hero-copy{
  flex:0 1 720px;
  min-width:0;
  padding-top:0;
}
.contact-hero h1{
  font-size:clamp(55px,8vw,100px);
  margin:0 0 20px;
}
.contact-hero .contact-hero-message{
  margin:0;
  max-width:700px;
  color:#aeb9c7;
  font-family:Arial,Helvetica,sans-serif;
  font-size:18px;
  line-height:1.6;
  letter-spacing:0;
}
.contact-hero .contact-hero-message span{
  color:#d4aa58;
  font-weight:700;
}
.contact-hero-mark{
  flex:0 0 230px;
  min-height:0;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-left:6px;
}
.contact-hero-mark img{
  width:230px;
  max-width:100%;
  height:auto;
  opacity:1;
  mix-blend-mode:normal;
  filter:saturate(1.35) contrast(1.18) brightness(1.08) drop-shadow(0 12px 24px rgba(0,0,0,.28));
}
@media(max-width:900px){
  .contact-hero-refined{gap:28px}
  .contact-hero-mark{flex-basis:190px}
  .contact-hero-mark img{width:190px}
}
@media(max-width:760px){
  .contact-hero{padding:120px 0;min-height:480px}
  .contact-hero-refined{display:block}
  .contact-hero-copy{max-width:700px}
  .contact-hero-mark{
    margin:28px 0 0;
    justify-content:flex-start;
  }
  .contact-hero-mark img{width:160px}
}


/* V35.8.6 — classic contact hero restoration */
.contact-hero{
  position:relative;
  padding:120px 0;
  min-height:480px;
  background:linear-gradient(135deg,#071321 0%,#0a1c31 58%,#0d2c4a 100%);
  overflow:hidden;
}
.contact-hero-classic{
  position:relative;
  min-height:240px;
}
.contact-hero-copy{
  position:relative;
  z-index:2;
  max-width:760px;
}
.contact-hero h1{
  font-size:clamp(55px,8vw,100px);
  margin:0 0 20px;
}
.contact-hero .contact-hero-message{
  margin:0;
  color:#aeb9c7;
  max-width:700px;
  font-family:Arial,Helvetica,sans-serif;
  font-size:18px;
  line-height:1.6;
  letter-spacing:0;
}
.contact-hero .contact-hero-message span{
  color:#d4aa58;
  font-weight:700;
}
.contact-hero-watermark{
  position:absolute;
  right:3%;
  top:50%;
  transform:translateY(-50%);
  z-index:1;
  width:min(28vw,250px);
  pointer-events:none;
}
.contact-hero-watermark img{
  width:100%;
  height:auto;
  display:block;
  opacity:.92;
  mix-blend-mode:screen;
  filter:saturate(1.55) contrast(1.22) brightness(1.08) drop-shadow(0 14px 28px rgba(0,0,0,.22));
}
@media(max-width:900px){
  .contact-hero-watermark{
    right:2%;
    width:min(24vw,190px);
    opacity:.85;
  }
}
@media(max-width:760px){
  .contact-hero{
    padding:100px 0 82px;
    min-height:auto;
  }
  .contact-hero-classic{
    min-height:0;
  }
  .contact-hero-watermark{
    position:relative;
    right:auto;
    top:auto;
    transform:none;
    width:150px;
    margin-top:26px;
  }
}
