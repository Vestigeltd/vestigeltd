{
  "name": "vestige-vapes-cloudflare-checkout",
  "version": "23.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/verify-cloudflare-build.js",
    "verify": "node scripts/verify-cloudflare-build.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vestige-checkout --local",
